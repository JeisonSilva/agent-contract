APIKEY=
MODELO_IA=
URL_BASE=
TEMPERATURE=0.7
MAX_TOKENS=2048

# Memória (opcional) — quando DATABASE_URL estiver definida, o agente ativa:
#   - Memória de sessão: checkpointing PostgreSQL via LangGraph (retoma execuções interrompidas)
#   - Memória semântica: pgvector para busca de análises anteriores similares
# Requer PostgreSQL com a extensão pgvector instalada.
DATABASE_URL=postgresql://user:password@localhost:5432/agent_memory